# ---- Server ----
PORT=5000
# Comma-separated list of browser origins allowed to call the API.
# Leave empty in development (allows any origin). Set it in production, e.g.
# CORS_ORIGIN=https://attachments.yourschool.ac.ke
CORS_ORIGIN=

# ---- PostgreSQL ----
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attachment_db

# ---- Auth ----
# REQUIRED. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts (e.g. 8h, 12h, 1d)
JWT_EXPIRES_IN=12h
